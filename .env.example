# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pizzaapp:pizzaapp123@localhost:5432/pizzaapp?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── NextAuth / Auth.js ─────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-auth-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# ─── Mercado Pago ───────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-custom-verify-token"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"

# ─── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="Pizzería <noreply@tudominio.com>"

# ─── JWT (tokens WhatsApp) ───────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-for-whatsapp-tokens"

# ─── IA del bot de WhatsApp ──────────────────────────────────────────────────
# Proveedor: "anthropic" o "gemini". Si no lo ponés, usa el que tenga API key.
# En el simulador podés elegir por chat sin tocar esto (para comparar).
WA_AI_PROVIDER="anthropic"

# Claude (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# Gemini (Google AI Studio). Los nombres de modelo se configuran acá para poder
# cambiarlos sin tocar código cuando Google saca uno nuevo.
GEMINI_API_KEY=""
GEMINI_PARSER_MODEL="gemini-2.5-flash"
GEMINI_EDITOR_MODEL="gemini-2.5-pro"
# El "pensamiento" de Gemini se cobra como salida. Poné 0 para apagarlo en el
# parser y abaratar; dejalo vacío para no mandar el parámetro.
GEMINI_THINKING_BUDGET=""

# ─── Notificaciones push (cambio de estado del pedido) ───────────────────────
# Sin estas variables la app funciona igual: simplemente no manda push.
#
# 1) Web / PWA (Web Push, VAPID). Generar UNA vez con:
#      npm run push:vapid --workspace=apps/web
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:pedidos@pizzacambalache.com.ar"
#
# 2) App nativa Android/iOS (Firebase Cloud Messaging).
#    Consola de Firebase → Configuración del proyecto → Cuentas de servicio →
#    "Generar nueva clave privada". Pegar el JSON entero, o en base64:
#      base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT_JSON=""
