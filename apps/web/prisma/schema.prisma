generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MOSTRADOR
}

enum OrderStatus {
  PENDIENTE_PAGO
  RECIBIDO
  CONFIRMADO
  PREPARANDO
  EN_HORNO
  LISTO
  EN_REPARTO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  MERCADO_PAGO
  EFECTIVO
  MIXTO
  TRANSFERENCIA
  // Pago con QR o tarjeta (débito/crédito). Cuenta como "virtual".
  TARJETA
  // Paga al retirar/recibir; el tipo real (efectivo/transferencia/mixto) se
  // define al registrar el cobro.
  A_DEFINIR
  // Cobra la plataforma: no entra plata al local, se liquida aparte. Cuenta
  // como venta "virtual" (igual que tarjeta o transferencia).
  PEDIDOS_YA
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  // Lo retira el repartidor de la plataforma: no es delivery nuestro ni un
  // retiro del cliente. No lleva dirección ni cobro en el local.
  PEDIDOS_YA
}

// ─── Auth.js Models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  name          String?
  password      String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  street    String
  number    String
  apartment String?
  city      String
  state     String
  zipCode   String?
  reference String?
  isDefault Boolean  @default(false)
  // El cliente pidió guardarla para reusarla en los próximos pedidos. Las que
  // no lo son existen solo para el pedido que las creó (el ticket las necesita)
  // y no se le ofrecen de nuevo.
  saved     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  categoryId  String
  stock       Int      @default(0)
  available   Boolean  @default(true)
  // Precios por tamaño para pizzas (null = no se ofrece en ese tamaño).
  priceSmall  Decimal? @db.Decimal(10, 2)
  priceMedium Decimal? @db.Decimal(10, 2)
  priceLarge  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category             @relation(fields: [categoryId], references: [id])
  cartItems      CartItem[]
  orderItems     OrderItem[]
  promotionItems PromotionItem[]
  promoSales     OrderPromotionItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([available])
  @@index([name])
}

// ─── Stock ────────────────────────────────────────────────────────────────────

enum StockMovementKind {
  ENTRADA // ingreso de mercadería (suma stock)
  SALIDA // merma/ajuste negativo (resta stock)
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  kind        StockMovementKind
  quantity    Int
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([kind])
  @@index([createdAt])
}

// Retiro del "dinero a favor" generado por la venta de postres. NO impacta en
// Finanzas: solo descuenta del disponible a favor de postres. El egreso real (si
// corresponde) se carga a mano en Finanzas, porque a veces el retiro no es dinero
// (p. ej. se cambia por mercadería).
model PostreWithdrawal {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Ajuste manual del "dinero a favor" de postres (firmado: + suma / − resta).
// Se usa, por ejemplo, para traer un saldo a favor de otro sistema.
model PostreAdjustment {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Promotion {
  id               String    @id @default(cuid())
  name             String
  description      String?
  promotionalPrice Decimal   @db.Decimal(10, 2)
  image            String?
  available        Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items      PromotionItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  promoSales OrderPromotionItem[]

  @@index([available])
  @@index([startDate, endDate])
}

model PromotionItem {
  id          String @id @default(cuid())
  promotionId String
  productId   String
  quantity    Int    @default(1)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
  @@index([promotionId])
}

// Composición real de cada promoción vendida: qué productos llevó puestos.
// Sin esto, una promo se guarda como un solo ítem y los gustos elegidos quedan
// como TEXTO en las notas, así que no hay forma de saber cuántas empanadas de
// carne salieron de verdad.
//
// Es un SNAPSHOT del momento de la venta: si mañana cambia la definición de la
// promo, los pedidos viejos siguen mostrando lo que realmente se entregó.
// NO afecta precios ni totales: la plata la sigue llevando el OrderItem de la
// promo. Esto es solo composición, para reportes y compras.
model OrderPromotionItem {
  id          String   @id @default(cuid())
  orderId     String
  promotionId String
  productId   String
  quantity    Int
  // true = lo eligió el cliente ("empanadas a elección").
  // false = viene fijo en la promo.
  chosen      Boolean  @default(false)
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([promotionId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String?
  promotionId String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@index([cartId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique
  userId             String
  addressId          String?
  status             OrderStatus   @default(RECIBIDO)
  deliveryType       DeliveryType  @default(DELIVERY)
  paymentMethod      PaymentMethod
  subtotal           Decimal       @db.Decimal(10, 2)
  deliveryFee        Decimal       @default(0) @db.Decimal(10, 2)
  // Descuento aplicado al pedido (mostrador). total = subtotal + envío − descuento.
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  // Propina para el repartidor (delivery, la deja el cliente). Se suma al total.
  tip                Decimal       @default(0) @db.Decimal(10, 2)
  total              Decimal       @db.Decimal(10, 2)
  // Sólo para paymentMethod = MIXTO: cuánto paga en efectivo y cuánto por transferencia.
  cashAmount         Decimal?      @db.Decimal(10, 2)
  transferAmount     Decimal?      @db.Decimal(10, 2)
  // Efectivo con el que paga el cliente ("paga con"), para calcular el vuelto.
  cashReceived       Decimal?      @db.Decimal(10, 2)
  notes              String?
  phone              String?
  // Repartidor que pasa a buscar el pedido (Pedidos Ya).
  courierName        String?
  whatsappToken      String?
  estimatedTime      Int?
  // Pedido programado: horario elegido por el cliente ("Programar para después").
  // Null = "lo antes posible" (el local carga el tiempo estimado a mano).
  scheduledFor       DateTime?
  // Marcas de tiempo para medir la demora real: inicio (creación/entrada a
  // cocina) y fin (entregado). Sirven para calcular a futuro un tiempo estimado
  // por tipo de pedido (pizzas/empanadas/complejidad/envío).
  startedAt          DateTime?
  finishedAt         DateTime?
  deliveryEmployeeId String?
  // Pedido de SIMULACIÓN (caja de entrenamiento): se borra al cerrar la caja test.
  isTest             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  address          Address?             @relation(fields: [addressId], references: [id])
  deliveryEmployee Employee?            @relation("OrderDeliveryEmployee", fields: [deliveryEmployeeId], references: [id])
  items            OrderItem[]
  promoItems       OrderPromotionItem[]
  payment          Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([deliveryEmployeeId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  promotionId String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  notes       String?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@index([orderId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(cuid())
  orderId             String        @unique
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(10, 2)
  mpPaymentId         String?
  mpPreferenceId      String?
  mpExternalReference String?
  mpStatus            String?
  mpStatusDetail      String?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([mpPaymentId])
}

// ─── Settings ─────────────────────────────────────────────────────────────────

// Barrios y countries de la zona, con la franja en la que NO se llega a
// repartir ahí (típicamente el mediodía en los barrios privados). El cliente
// escribe el nombre del barrio en el campo de calle, así que el cruce es por
// nombre. Ver delivery-area.service.
model DeliveryArea {
  id          String   @id @default(cuid())
  name        String
  // Franja sin reparto, "HH:MM". Vacías = se reparte en todo el horario.
  blockedFrom String?
  blockedTo   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShipmentZone {
  id        String   @id @default(cuid())
  name      String
  radiusKm  Float
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryFees DeliveryFee[]
}

model DeliveryFee {
  id             String   @id @default(cuid())
  shipmentZoneId String?
  name           String
  fee            Decimal  @db.Decimal(10, 2)
  minOrderAmount Decimal? @db.Decimal(10, 2)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  zone ShipmentZone? @relation(fields: [shipmentZoneId], references: [id])
}

// Ajustes sueltos del negocio, clave→valor. Para cosas que no justifican una
// tabla propia (ej. "molde-disabled": la pizza al molde no se puede pedir
// porque se quedaron sin masa). Ver APP_SETTING_KEYS.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Foto de las tarjetas "armables" del menú (mitad y mitad, empanadas sueltas).
// No son productos ni promos —se arman con varios— así que no tienen dónde
// guardar la imagen: va acá, con la clave de la tarjeta.
model MenuCardImage {
  key       String   @id
  image     String
  updatedAt DateTime @updatedAt
}

// Descuento general de la app: se le aplica a los pedidos que hacen los
// CLIENTES desde la web. Los que toma el local (mostrador/admin) no lo llevan.
// Es una sola fila (id fijo APP_DISCOUNT_ID); se edita desde Configuración.
model AppDiscount {
  id         String   @id
  // Porcentaje sobre el subtotal de productos (no sobre la propina).
  percentage Decimal  @default(0) @db.Decimal(5, 2)
  // Motivo visible para el cliente: "Promo lanzamiento".
  label      String   @default("")
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int
  // Turno del día: 0 = mediodía, 1 = noche. Existe porque el local abre en dos
  // tramos (ej. 11–15 y 18–00) y con una sola fila por día no se podía expresar.
  shift     Int      @default(0)
  openTime  String
  closeTime String
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, shift])
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────────

model WhatsAppConversation {
  id            String    @id @default(cuid())
  phone         String    @unique
  waId          String
  state         String    @default("MENU")
  context       Json?
  // Nombre de perfil del cliente en WhatsApp (para el inbox).
  contactName   String?
  // Takeover humano: si está en true, el bot NO responde (atendés a mano).
  botPaused     Boolean   @default(false)
  // Para ordenar el inbox y marcar no leídos.
  lastMessageAt DateTime?
  unread        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([phone])
  @@index([lastMessageAt])
}

// Cada mensaje del hilo (entrante/saliente) para mostrar la conversación en el panel.
model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  // 'IN' = del cliente, 'OUT' = del negocio (bot o humano).
  direction      String
  // text | image | interactive | audio | document | ...
  type           String   @default("text")
  body           String?
  // Comprobantes/imágenes: media guardada.
  mediaUrl       String?
  mediaMime      String?
  // Id del mensaje en WhatsApp (para deduplicar y estados).
  waMessageId    String?
  // Para salientes: sent | delivered | read | failed.
  status         String?
  // Quién lo mandó si fue saliente humano.
  sentById       String?
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([waMessageId])
}

// ─── Entrenamiento del bot de WhatsApp ────────────────────────────────────────

// Instrucciones del bot (el texto que antes vivía en wa-bot-instructions.md).
// Cada guardado —tuyo a mano o destilado por la IA— crea una VERSIÓN nueva: la
// última es la activa y las anteriores quedan para restaurar. En producción el
// archivo vive dentro de la imagen Docker, así que la DB es el único lugar donde
// una edición sobrevive a un deploy.
model BotInstruction {
  id          String   @id @default(cuid())
  version     Int      @unique
  content     String   @db.Text
  // De dónde salió esta versión: 'seed' | 'manual' | 'destilado'.
  source      String   @default("manual")
  // Nota corta para el historial ("destilado de 8 correcciones").
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Una corrección del operador: "esto dijo el bot / esto tendría que haber dicho".
// Mientras está pendiente se le pasa a la IA como ejemplo (few-shot). Al destilar
// se absorbe en las instrucciones y queda marcada como aplicada.
model WABotCorrection {
  id             String    @id @default(cuid())
  conversationId String?
  // Últimos turnos del chat que llevaron a esa respuesta (ParserTurn[]).
  context        Json
  // Lo que el bot respondió.
  badReply       String    @db.Text
  // Lo que tendría que haber respondido.
  goodReply      String    @db.Text
  // Por qué estaba mal (opcional, ayuda mucho al destilar).
  note           String?
  // Cuándo se absorbió en las instrucciones (null = pendiente).
  appliedAt      DateTime?
  // Versión de instrucciones que la absorbió.
  appliedVersion Int?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([appliedAt, createdAt])
}

model WhatsAppToken {
  id        String   @id @default(cuid())
  token     String   @unique
  phone     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([phone])
  @@index([expiresAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Finance ─────────────────────────────────────────────────────────────────

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum FinancePaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  // Egreso mixto: parte en efectivo (cashAmount) y el resto virtual.
  MIXTO
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashShift {
  MANANA
  NOCHE
}

enum EmployeeRole {
  COCINERO
  REPARTIDOR
  OTRO
}

model CashRegister {
  id             String             @id @default(cuid())
  status         CashRegisterStatus @default(OPEN)
  shift          CashShift?
  // Caja de SIMULACIÓN (entrenamiento): sus pedidos/movimientos no impactan en
  // reportes y se borran al cerrarla.
  isTest         Boolean            @default(false)
  openingBalance Decimal            @db.Decimal(10, 2)
  expectedCash   Decimal?           @db.Decimal(10, 2)
  countedCash    Decimal?           @db.Decimal(10, 2)
  difference     Decimal?           @db.Decimal(10, 2)
  notes          String?
  openedById     String?
  closedById     String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions FinanceTransaction[]

  @@index([status])
  @@index([openedAt])
}

model FinanceTransaction {
  id             String                 @id @default(cuid())
  cashRegisterId String?
  type           FinanceTransactionType
  amount         Decimal                @db.Decimal(10, 2)
  // Solo para paymentMethod = MIXTO: porción en efectivo (el resto es virtual).
  cashAmount     Decimal?               @db.Decimal(10, 2)
  category       String
  description    String?
  paymentMethod  FinancePaymentMethod
  orderId        String?
  employeeId     String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  employee     Employee?     @relation(fields: [employeeId], references: [id])

  @@index([cashRegisterId])
  @@index([employeeId])
  @@index([type])
  @@index([createdAt])
}

model Employee {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  phone         String?
  relativePhone String?
  address       String?
  role          EmployeeRole @default(OTRO)
  dailyWage     Decimal      @db.Decimal(10, 2)
  hireDate      DateTime
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transactions   FinanceTransaction[]
  movements      EmployeeMovement[]
  deliveryOrders Order[]              @relation("OrderDeliveryEmployee")

  @@index([active])
  @@index([role])
}

enum EmployeeMovementKind {
  ADELANTO // adelanto otorgado (suma al pendiente; normalmente desde Finanzas)
  ADELANTO_DESCUENTO // descuento del adelanto (resta del pendiente, sin tocar caja)
  ACUMULADO_APORTE // el empleado "guarda" sueldo (suma a favor)
  ACUMULADO_RETIRO // retiro del acumulado a favor
}

model EmployeeMovement {
  id                   String               @id @default(cuid())
  employeeId           String
  kind                 EmployeeMovementKind
  amount               Decimal              @db.Decimal(10, 2)
  note                 String?
  financeTransactionId String?              @unique
  // Movimiento de SIMULACIÓN (caja test): se borra al cerrar la caja.
  isTest               Boolean              @default(false)
  createdById          String?
  createdAt            DateTime             @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([kind])
  @@index([createdAt])
}
